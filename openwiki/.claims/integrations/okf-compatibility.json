  "claims": [
    {
      "id": "claim_ba5c036f80ca493c944d49399c06c34e",
      "statement": "docsweep separates OKF's status frontmatter field (a document lifecycle axis with v0.2 values draft/stable/deprecated) from its own docsweep_state field (the work-tracking axis: planned/in-progress/watching/done/discarded/pending), and detect.py's _detect_frontmatter() only treats a legacy top-level status value as a docsweep work state when that value is not one of the active profile's own OKF lifecycle values.",
      "evidence": [
        {
          "resource": "repo://docs/okf-mapping.md#L12-L14",
          "version": "repo-lines-v1:sha256:3376288755b641eadb36f1ea59773318335f98a361dac96d7b4c5ffb6dd455dc:"
        },
