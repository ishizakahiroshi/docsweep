    {
      "id": "claim_7cdc32f27b954c5f8a346ea8e7fee201",
      "statement": "docsweep/cli/__init__.py's main() dispatches subcommands through a _DISPATCH dict, and if the first argv token is not a known subcommand, not a flag, and not an existing directory, it fails immediately with exit code 2 rather than treating a typo as an empty scan.",
      "evidence": [
        {
          "resource": "repo://docsweep/cli/__init__.py#L128-L144",
          "version": "repo-lines-v1:sha256:34fc158a0b9b4ac4f3bf07044ec75d988eed6e1ab08d56a9f977d64018755268:"
        }
      ]
    },
    {
      "id": "claim_0364cbc2b6f646c0a298279b3a205112",
      "statement": "engine.classify() only computes decision-support flags (needs_fix, conflict, stale, needs_decision, overdue_todo, overdue_graduate, due_parse_error) and a closed set of allowed_actions derived from the document's current state; it never mutates or moves files itself.",
      "evidence": [
        {
          "resource": "repo://docsweep/engine.py#L24-L82",
          "version": "repo-lines-v1:sha256:a4b83a6d35ff8238ed3655f77f28277001938440e9a7f7712482b12a02d05709:"
        }
      ]
    },
    {
      "id": "claim_a3676a79ebf94e0f947bd8abaafe7b41",
      "statement": "auto_sweep (the --auto/sweep batch mover) only operates on documents whose state is already done or discarded (auto_movable records); the watching state is excluded from any automatic archive path and only becomes eligible via the explicitly invoked promote --due-expired flow.",
