    {
      "id": "claim_c170cc9a850040f885f97961c1c84c62",
      "statement": "Project boundaries are detected by walking upward from a matched file to the nearest ancestor directory containing one of the configurable project markers (.git, .docsweep.yaml, package.json, pyproject.toml by default), not by assuming a fixed folder depth under a configured scan root.",
