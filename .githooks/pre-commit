#!/usr/bin/env sh
# doxguard published gate begin
dg_install='Install doxguard 0.2.0 once: npm install --global doxguard@0.2.0'
if ! command -v doxguard >/dev/null 2>&1; then
  echo "doxguard: required installed version missing. $dg_install" >&2
  exit 2
fi
dg_version=$(doxguard --version 2>/dev/null) || {
  echo "doxguard: installed version check failed. $dg_install" >&2
  exit 2
}
if [ "$dg_version" != 'doxguard 0.2.0' ]; then
  echo "doxguard: installed version must be exactly 0.2.0. $dg_install" >&2
  exit 2
fi
dg_config=${DOXGUARD_CONFIG:-doxguard.ci.json}
doxguard scan --staged --block --strict --config "$dg_config" || exit $?
# doxguard published gate end

# --- omitnix: 生成物の鮮度検査（2026-09-11 追加） ---
# コミット済みの .omitnix/index.json が、いまのソースと食い違っていたら止める。
# 書き換えはしない。hook が生成物を書き換えると、レビューされていない内容が
# コミットへ混ざるため。止まったら `omitnix` を実行して差分を確認し、
# 生成された index.json を自分で git add すること。
# 新規ファイルの gate（--gate）は意図的に入れていない。
if command -v omitnix >/dev/null 2>&1; then
	omitnix --check || exit 1
elif command -v python >/dev/null 2>&1 && python -c "import omitnix" >/dev/null 2>&1; then
	python -m omitnix --check || exit 1
fi
