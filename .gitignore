# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg
.venv/
venv/
env/
.env

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Packaging (PyInstaller)
*.spec
*.manifest

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# AI ツールのローカル状態・生成物
.claude/
# Cursor Agent CLI にはグローバル指示の口が無いため、共通ルールへのポインタを .cursor/rules に置く。
# 作者環境の絶対パスを含むので追跡しない。
.cursor/
# many-ai-cli が opencode セッション中だけ cwd に書く permission 設定と排他ロック。
# セッションが kill されると置き去りになるため追跡しない。
opencode.json*
*.log
*.jsonl
*.tmp
*.bak
*.orig
*.rej

# === 機密・ローカル専用ファイルは絶対にコミットしない ===
# --- 認証情報・secrets・鍵 ---
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
.env.*
*.env
secrets.*
*secret*
!docsweep/secrets_guard.py
*credential*
*token*
.netrc
.npmrc
.pypirc

# --- ローカル専用ファイル ---
*.local
*.local.*
*.secret.*

# docsweep の個人作業ログ（公開しない）
docs/local/

# 作業 md の archive は docs/local/archive/ が正しい置き場。
# リポ直下の archive/ に置かれたものも同じ「非公開の作業ログ」として扱う
# （2026-09-04: plan 3 本がここで公開追跡されていたのを git rm --cached で外した）。
/archive/

# AI 監査の生レポート（人間レビュー前は公開しない）
/docs/ai-audit-prompts/

# Obsidian knowledge artifacts are not public repository content.
/docs/obsidian/

# docsweep 実行時の生成物（スキャン結果・履歴）
INDEX.md
INDEX.json
.docsweep/

# テスト用 fixture / golden は上の無視パターンより優先して追跡する。
# docsweep は INDEX.md・*.jsonl（移動ログ）・各種 *.md を生成するため、
# それらの期待値を testdata に置くと黙って脱落する。ディレクトリ単位で明示許可。
!**/testdata/**
!**/tests/fixtures/**
# === obsidian-link: managed ===
/docs/obsidian/
# === /obsidian-link: managed ===
